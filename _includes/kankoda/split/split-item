{% assign _item = include.item %}
<div class="split-container slide-in">
  <div>
    {% if _item.eyebrow %}
    <p class="eyebrow">{{ _item.eyebrow }}</p>
    {% endif %}
    {% assign item_title = _item.title | default: _item.name %}
    <h2 id="{{ item_title | slugify }}">{{ item_title }}</h2>
    <p>{{ _item.text }}</p>
  </div>
  <img src="{{ _item.split-image | default: _item.image | default: _item.icon }}" alt="{{ item_title }}" />

  <img src="{{ _item.split-image | default: _item.image }}" alt="{{ item_title }}" />
  <div class="split-actions">
    {% if _item.url %}
    <a class="cta glass" href="{{_item.url}}">{{ include.button-text | default: "Read More" }}</a>
    {% endif %}
    {% if _item.url_appstore %}
    <a class="cta" href="{{_item.url_appstore}}">Download</a>
    {% endif %}
  </div>
</div>
