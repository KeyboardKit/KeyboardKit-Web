<div class="split-container slide-in">
  <div>
    {% if include.item.eyebrow %}
    <p class="eyebrow">{{ include.item.eyebrow }}</p>
    {% endif %}
    {% assign item_title = include.item.title | default: include.item.name %}
    <h2 id="{{ item_title | slugify }}">{{ item_title }}</h2>
    <p>{{ include.item.text }}</p>
  </div>
  <img src="{{ include.item.split-image | default: include.item.image }}" alt="{{ item_title }}" />
  <div class="split-actions">
    {% if include.item.url %}
    <a class="cta glass" href="{{include.item.url}}">{{ include.button-text | default: "Read More" }}</a>
    {% endif %}
    {% if include.item.url_appstore %}
    <a class="cta" href="{{include.item.url_appstore}}">Download</a>
    {% endif %}
  </div>
</div>
