#!/bin/bash

# Documentation:
# This script syncs the web foundation to another folder.
# Only files that are newer than their target are copied.
# Target files that no longer exist in the source are removed.

set -e  # Exit immediately if a command exits with non-zero status

TARGET=$1

if [ -z "$TARGET" ]; then
  echo "Usage: ./sync-to <target-folder>"
  exit 1
fi

# Sync a file or folder to the same path in the target.
sync() {
  if [ -d "$1" ]; then
    mkdir -p "$TARGET/$1"
    rsync -a --update --delete "$1/" "$TARGET/$1/"
  else
    mkdir -p "$TARGET/$(dirname "$1")"
    rsync -a --update "$1" "$TARGET/$1"
  fi
}

sync serve
sync sync-to

sync scripts

sync _includes/kankoda

sync _layouts/blog.html
sync _layouts/page.html
sync _layouts/page-sidebar.html
sync _layouts/plain.html
sync _layouts/post.html
sync _layouts/side-menu.html

sync _sass/kankoda

sync assets/kankoda

sync js/kankoda
sync js/kankoda.js

sync assets/main.scss
